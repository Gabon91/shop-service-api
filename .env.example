# Optional direct PostgreSQL connection for database tools.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

SUPABASE_URL=
# Server-side Supabase service-role key. Never expose this to a browser.
SUPABASE_KEY=
# Comma-separated frontend origins (origin only, no trailing slash or path).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://shop-ui-react.vercel.app
# Optional: set ENV_FILE in the process environment to select a different file.
